# Copy to .env.local and fill in. Never commit .env.local.
# Values: Supabase dashboard -> Project Settings -> API.
# Only NEXT_PUBLIC_* variables reach the browser. Never give the service role key a NEXT_PUBLIC_ prefix.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key (public, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server only, never NEXT_PUBLIC, never commit. Bypasses RLS.
# Used by createAdminClient() (src/lib/supabase/admin.ts) and npm run seed:dev.
SUPABASE_SERVICE_ROLE_KEY=

# Web push notifications (src/features/notifications). Generate a key pair once with
#   npx web-push generate-vapid-keys
# and use the same pair everywhere (local and Vercel): phones subscribed with one public key only accept that pair.
# Without these the app works, but the "Uključi obaveštenja" card is hidden and nothing is sent.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: a mailto: or https URL.
VAPID_SUBJECT=
