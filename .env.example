# Copy to .env.local and fill in. Never commit .env.local.
# Values: Supabase dashboard -> Project Settings -> API.
# Only NEXT_PUBLIC_* variables reach the browser; never put the service role key here.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key (public, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
